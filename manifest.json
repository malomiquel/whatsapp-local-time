{
  "manifest_version": 3,
  "name": "WhatsApp Local Time",
  "version": "1.1.0",
  "description": "See the real local time of WhatsApp Web contacts (and each group member) living in another time zone.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "WhatsApp Local Time",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "permissions": ["storage"],
  "host_permissions": ["https://web.whatsapp.com/*"],
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["timezones.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
